# Database. Local dev uses a SQLite file via libSQL; production uses Turso.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Auth. In production JWT_SECRET must be a random string of 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Google sign-in for DMs. The OAuth client ID (type "Web application") from the Google
# Cloud Console. No client secret is needed. See README for the setup steps.
GOOGLE_CLIENT_ID=

# Rate limit on the sign-in routes, per IP address (defaults shown)
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
# Number of reverse proxies in front of the app (usually 1 when hosted). Leave empty if none.
TRUST_PROXY=

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Seeding (npm run db:seed) only syncs the ability catalog; it needs no settings.
# DMs sign in through Google and create their own players.
